# Copy this file to .env.local and replace placeholders there.
# Never put real API keys in this example file.

# preview: save email locally without sending (development only).
# resend: send real email after completing all settings below.
EMAIL_MODE=preview

# Resend dashboard > API Keys. Create a sending-access key for your domain.
RESEND_API_KEY=

# Sender address on a domain you have verified in Resend.
EMAIL_FROM="Knovera <books@your-verified-domain.com>"

# Local URL for previews. Live delivery requires your public HTTPS store URL.
EMAIL_SITE_URL=http://127.0.0.1:3000

# Business mailing address included in newsletters; required for campaigns.
EMAIL_POSTAL_ADDRESS=""

# Optional: absolute path on persistent storage. Default: .data/email.sqlite
# EMAIL_DB_PATH="E:/SR Store/.data/email.sqlite"

# Supabase Postgres: server-only connection string from Project > Connect.
# Use the session pooler for this long-running Next.js server (IPv4 compatible).
# URL-encode special characters in the database password. Never use NEXT_PUBLIC.
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
SUPABASE_DB_URL=
# Optional path to the Supabase root certificate when required by your connection.
# Certificate verification is always enabled for remote databases.
# SUPABASE_DB_CA_FILE="C:/certificates/supabase-ca.crt"

# Admin sign-in is still UI-only; Supabase Auth and Storage are separate integrations.
